<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup and device-transfer policy.

  Applies to android:dataExtractionRules. Android below 31 uses the sibling
  res/xml/backup_rules.xml (android:fullBackupContent) instead.

  Why: the local Room database is a device-local upload queue whose records are
  only meaningful on the device that produced them (they are keyed to that
  install's device registration). Restoring it onto another device could make the
  app treat un-uploaded media as already backed up, so it must not travel through
  cloud backup or device-to-device transfer. Everything else the app stores may
  still be backed up, so backup is NOT disabled overall (allowBackup stays true).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="upload_queue.db" />
        <exclude domain="database" path="upload_queue.db-wal" />
        <exclude domain="database" path="upload_queue.db-shm" />
        <exclude domain="database" path="upload_queue.db-journal" />
        <!-- The encrypted vault directory never leaves the device: not via
             cloud backup, and not via device-to-device transfer. -->
        <exclude domain="file" path="vault/" />
        <exclude domain="sharedpref" path="mydrive_vault_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="upload_queue.db" />
        <exclude domain="database" path="upload_queue.db-wal" />
        <exclude domain="database" path="upload_queue.db-shm" />
        <exclude domain="database" path="upload_queue.db-journal" />
        <!-- The encrypted vault directory never leaves the device: not via
             cloud backup, and not via device-to-device transfer. -->
        <exclude domain="file" path="vault/" />
        <exclude domain="sharedpref" path="mydrive_vault_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
