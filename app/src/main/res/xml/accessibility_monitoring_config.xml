<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration for the My Drive monitoring foundation.

  Scope, deliberately narrow:
    * metadata only — window/app changes and lightweight interaction flags;
    * canRetrieveWindowContent is required to read node flags (class name,
      editable/clickable/scrollable, password detection) for the CURRENT window
      only, and the service never walks the whole tree;
    * there is NO screen capture here: canTakeScreenshot is absent/false and no
      gesture-capable flags are set;
    * notification events are only collected when the device monitoring settings
      explicitly enable them (the service checks the switch at runtime).

  accessibilityEventTypes lists exactly the types this phase monitors. Anything
  not listed is never delivered to the service, which is the cheapest possible
  filter for battery and privacy.

  typeViewTextChanged is deliberately NOT subscribed: the monitoring requirement
  does not include typed text, and text-change events are the one subscription
  that can expose user input. Verified-vs-password protection is unaffected -
  password handling stays in the service, processor, repository and the database
  CHECK constraint.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused|typeViewScrolled|typeViewSelected|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="false"
    android:description="@string/accessibility_monitoring_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_monitoring_service_summary" />
