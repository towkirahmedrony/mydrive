<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (API 30-) backup policy.

  Applies to android:fullBackupContent. The API 31+ equivalent is
  res/xml/data_extraction_rules.xml.

  Same rationale as there: exclude the local Room database (a device-local upload
  queue keyed to this install's device registration) from cloud backup and device
  transfer. Backup is not disabled overall.
-->
<full-backup-content>
    <exclude domain="database" path="upload_queue.db" />
    <exclude domain="database" path="upload_queue.db-wal" />
    <exclude domain="database" path="upload_queue.db-shm" />
    <exclude domain="database" path="upload_queue.db-journal" />
        <!-- The encrypted vault directory never leaves the device: not via
             cloud backup, and not via device-to-device transfer. -->
        <exclude domain="file" path="vault/" />
</full-backup-content>
